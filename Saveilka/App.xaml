<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Saveilka"
             xmlns:conv="clr-namespace:Saveilka.Conventors;assembly=Saveilka"
             x:Class="Saveilka.App">
    <Application.Resources>
        <ResourceDictionary>
            <!--Це конвертатори,шоб вони могли віздє буть-->
            <conv:RateColorConventors x:Key="RateColorConventors" />
            <conv:ImageConventor x:Key="ImageConventor" />
            <!---->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
